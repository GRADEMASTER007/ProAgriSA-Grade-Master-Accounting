rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'grademaster.appointments@gmail.com';
    }

    // Collection Matches
    match /companies/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /clients/{docId} {
      allow read, write: if isSignedIn();
    }

    match /products/{docId} {
      allow read, write: if isSignedIn();
    }

    match /shipping/{docId} {
      allow read, write: if isSignedIn();
    }

    match /quotes/{docId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{docId} {
      allow read, write: if isSignedIn();
    }

    match /payments/{docId} {
      allow read, write: if isSignedIn();
    }

    match /communications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /knowledge/{docId} {
      allow read, write: if isSignedIn();
    }

    match /activities/{docId} {
      allow read, write: if isSignedIn();
    }

    match /whatsapp_conversations/{docId} {
      allow read, write: if isSignedIn();
    }

    match /whatsapp_messages/{docId} {
      allow read, write: if isSignedIn();
    }

    match /email_conversations/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
